{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "NODE_ENV=production node backend/scripts/install-sample-content.js --confirm INSTALL_FICTIONAL_SAMPLE_CONTENT && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api(?:/(.*))?", "dest": "/api/[...path].js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
