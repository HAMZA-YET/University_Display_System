{
  "name": "@university-display/backend",
  "version": "2.0.0",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/bootstrap-production.js",
    "test": "jest --runInBand && node --test tests/operator-sample-content.test.cjs && node --test tests/security-cli.test.cjs",
    "smoke": "node scripts/smoke.js",
    "seed:development": "node src/seed/seed.js",
    "bootstrap:production": "node scripts/bootstrap-production.js",
    "test:readiness": "jest --config jest.readiness.config.cjs --runInBand",
    "test:operator": "node --test tests/operator-sample-content.test.cjs",
    "security:ops": "node scripts/security-operations.js"
  },
  "dependencies": {
    "@vercel/blob": "2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "otpauth": "^9.4.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "3.1.11",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "globalSetup": "<rootDir>/tests/helpers/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/helpers/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/helpers/setEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "type": "commonjs"
}
