NODE_ENV=development
PORT=5000
# Vercel Atlas provisions MONGODB_URI. Legacy MONGO_URI is also accepted.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Optional one-time first-administrator setup token (32+ random characters).
# Configure only in Vercel; remove after setup. No default is provided.
BOOTSTRAP_TOKEN=
CLIENT_ORIGIN=http://localhost:5173
UNIVERSITY_TZ=Asia/Seoul
BCRYPT_ROUNDS=12
# local for a persistent dev server; vercel-blob for connected private Vercel Blob.
ATTACHMENT_STORAGE=local
UPLOAD_DIR=./storage/uploads
# BLOB_STORE_ID is provisioned by OIDC Blob connections.
# BLOB_READ_WRITE_TOKEN is supported for token-based Blob connections.
# Leave credentials unset in source control; configure them on Vercel.
ENABLE_STATUS_SYNC=false
